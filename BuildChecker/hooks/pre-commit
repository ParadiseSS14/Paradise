#!/usr/bin/env bash

set -euo pipefail

gitroot=$(git rev-parse --show-toplevel)
cd "$gitroot"

files=()

while IFS= read -r file; do
  case "$file" in 
    *.yml|*.yaml)
      files+=("$file")
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -- Resources/Prototypes)

[[ ${#files[@]} -eq 0 ]] && exit 0

npx --yes prettier@3.6.2 --check "${files[@]}"
