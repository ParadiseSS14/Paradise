#!/usr/bin/env bash

set -euo pipefail

gitroot=$(git rev-parse --show-toplevel)
cd "$gitroot"

mapfile -t files < <(
    git diff --cached --name-only --diff-filter=AM -- Resources/Prototypes |
    grep -E '\.ya?ml$'
)

if (( ${#files[@]} != 0 )); then

    if ! command -v npm >/dev/null 2>&1; then
        echo "Node.js/npm is required to check YAML formatting."
        echo "Install Node.js, then run: npm ci"
        exit 1
    fi

    if [[ ! -x node_modules/.bin/prettier && ! -f node_modules/.bin/prettier.cmd ]]; then
        echo "Prettier is not installed."
        echo "Run: npm ci"
        exit 1
    fi
fi

npm run prettier:check "${files[@]}"
