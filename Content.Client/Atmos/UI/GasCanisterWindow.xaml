<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:s="clr-namespace:Content.Client.Stylesheets"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:xe="clr-namespace:Content.Client.UserInterface.XamlExtensions"
                      MinSize="480 400" Title="Canister">
    <BoxContainer Orientation="Vertical" Margin="5 5 5 5" SeparationOverride="10">

        <PanelContainer StyleClasses="SurfacePrimary" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
                    <Label Text="{Loc 'comp-gas-canister-ui-canister-status'}" StyleClasses="LabelHeading"
                           Margin="8 8 0 0" />
                    <Control HorizontalExpand="True"/>
                    <TextureButton Name="PortStatusLabel"
                                   TexturePath="FA-gear"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   MaxWidth="24"
                                   MaxHeight="24"
                                   ModulateSelfOverride="#d3e0e4cc" />
                </BoxContainer>

                <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" Margin="0 8 0 0" />

                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">

                    <Control HorizontalExpand="True" VerticalExpand="True" SizeFlagsStretchRatio="1.75">
                        <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True"
                                      Margin="16 0">
                            <ProgressBar Name="PressureBar"
                                         HorizontalExpand="True"
                                         MaxValue="1"
                                         MinValue="0"
                                         SetHeight="25"
                                         Margin="0 8 0 8"
                                         VerticalExpand="True"
                                         MinWidth="100"
                                         StyleClasses="TguiProgressBar">
                                <Label Name="PressureLabel" HorizontalAlignment="Right" Margin="0 0 8 0"
                                       SizeFlagsStretchRatio="2"
                                       StyleClasses="LabelSmallText" />
                            </ProgressBar>
                            <Label Text="{Loc comp-gas-canister-ui-canister-pressure}" StyleClasses="LabelSubText"
                                   HorizontalAlignment="Center" Margin="0 4 0 8" />
                        </BoxContainer>
                    </Control>


                    <Control HorizontalExpand="True" VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalAlignment="Center">
                            <Control MinHeight="16" />
                            <FloatSpinBox Name="ReleasePressure" MaxWidth="110" Align="Center" MaxHeight="20" />
                            <controls:TguiKnob Name="ReleasePressureSlider" SetSize="64 64"
                                               RingTextureOverride="{xe:Tex '/Textures/Interface/radial-progress-ring.png'}" />

                            <Control VerticalExpand="True" />
                            <Label Text="{Loc comp-gas-canister-ui-release-pressure}" Margin="0 4 0 8"
                                   StyleClasses="LabelSubText" HorizontalAlignment="Center" />
                        </BoxContainer>
                    </Control>

                    <Control HorizontalExpand="True" VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalAlignment="Center">
                            <Control HorizontalExpand="True" VerticalExpand="True">
                                <Button Name="ReleaseValveOpenButton"
                                        ToggleMode="True" VerticalAlignment="Center">
                                    <Label Text="{Loc comp-gas-canister-ui-release-valve-open}"
                                           Name="ReleaseValveLabelStatusButton" StyleClasses="LabelSmallText"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Control>
                            <Label Text="{Loc comp-gas-canister-ui-release-valve}" StyleClasses="LabelSubText"
                                   HorizontalAlignment="Center" Margin="0 4 0 8" />
                        </BoxContainer>
                    </Control>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>


        <PanelContainer StyleClasses="SurfacePrimary" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                    <Label Text="{Loc comp-gas-canister-ui-holding-tank-status}" StyleClasses="LabelHeading"
                           Margin="8 8 0 0" />
                    <Control HorizontalExpand="True"/>
                </BoxContainer>

                <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" Margin="0 8 0 0" />

                <BoxContainer Orientation="Vertical" HorizontalExpand="True">

                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc comp-gas-canister-ui-holding-tank-label}" />
                        <Label Name="TankLabelLabel" Text="{Loc comp-gas-canister-ui-holding-tank-label-empty}" Align="Center"
                               HorizontalExpand="True" />
                        <Button Name="TankEjectButton" Text="{Loc comp-gas-canister-ui-holding-tank-eject}" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc comp-gas-canister-ui-holding-tank-pressure}" />
                        <Label Name="TankPressureLabel" Align="Center" HorizontalExpand="True" />
                    </BoxContainer>

                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

    </BoxContainer>
</controls:FancyWindow>
