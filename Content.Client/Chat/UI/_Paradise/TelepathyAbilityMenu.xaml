<controls:FancyWindow xmlns="https://spacestation14.io"
             xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
             Title="{Loc 'telepathy-ui-window-title'}"
             HideIcon="True"
             Resizable="False"
             MinHeight="250">
    <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="8" MinWidth="150">
        <ScrollContainer VerticalExpand="True">
            <ItemList Name="TargetsList" SelectMode="Single"/>
        </ScrollContainer>
        <Button Name="SelectButton" Text="{Loc 'telepathy-ui-select-target'}"/>
    </BoxContainer>
</controls:FancyWindow>
