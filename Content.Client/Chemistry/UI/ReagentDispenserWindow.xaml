<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls"
                      xmlns:ui="clr-namespace:Content.Client.Chemistry.UI"
                      Title="{Loc 'reagent-dispenser-bound-user-interface-title'}"
                      MinSize="600 300"
                      SetSize="700 650">
    <BoxContainer Orientation="Vertical" Margin="8">
        <PanelContainer VerticalExpand="True" StyleClasses="SurfacePrimary">
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True">
                <BoxContainer Orientation="Horizontal" Margin="8 8 8 0" HorizontalExpand="True">
                    <Label Text="{Loc 'reagent-dispenser-window-beaker'}" StyleClasses="LabelHeading"
                           HorizontalExpand="True" />

                    <ui:ButtonGrid
                        Name="AmountGrid"
                        Access="Public"
                        Columns="9"
                        ButtonList="1,5,10,15,20,25,30,50,100"
                        RadioGroup="True">
                    </ui:ButtonGrid>
                </BoxContainer>
                <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" Margin="0 8 0 0" />
                <ScrollContainer HScrollEnabled="False"
                                 HorizontalExpand="True"
                                 VerticalExpand="True"
                                 MinHeight="50"
                                 SizeFlagsStretchRatio="2.5">
                    <GridContainer Name="ReagentList"
                                   HorizontalExpand="True"
                                   VerticalExpand="True"
                                   Access="Public"
                                   Columns="3"
                                   Margin="8" />
                </ScrollContainer>
            </BoxContainer>
        </PanelContainer>

        <Control MinHeight="8" />

        <PanelContainer VerticalExpand="True" StyleClasses="SurfacePrimary" MinHeight="50"
                        SizeFlagsStretchRatio="0.45">
            <BoxContainer Orientation="Vertical">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="8 8 8 0">
                    <Label Text="{Loc 'reagent-dispenser-window-beaker'}" StyleClasses="LabelHeading"
                           HorizontalExpand="True" />

                    <Button Name="ClearButton"
                            Access="Public"
                            Text="{Loc 'reagent-dispenser-window-clear-button'}"
                            StyleClasses="OpenRight"
                            VerticalAlignment="Center" Margin="4 0" />
                    <Button Name="EjectButton"
                            Access="Public"
                            Text="{Loc 'reagent-dispenser-window-eject-button'}"
                            StyleClasses="OpenLeft"
                            VerticalAlignment="Center"
                            Margin="4 0" />
                </BoxContainer>
                <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" Margin="0 8 0 0" />

                <BoxContainer Orientation="Horizontal" Margin="8">
                    <BoxContainer Orientation="Vertical">
                        <Label Name="ContainerInfoName"
                               Access="Public"
                               Text=""
                               HorizontalAlignment="Center" />
                        <Label Name="ContainerInfoFill"
                               Access="Public"
                               Text=""
                               HorizontalAlignment="Center"
                               StyleClasses="LabelSubText" />
                        <SpriteView Name="View"
                                    Scale="4 4"
                                    HorizontalAlignment="Center" />
                    </BoxContainer>
                    <PanelContainer StyleClasses="SurfaceSunken" HorizontalExpand="True"
                                    VerticalExpand="True"
                                    Margin="8">
                        <ScrollContainer HScrollEnabled="False">
                        <GridContainer Name="ContainerInfo"
                                       Rows="6"
                                       Columns="4"
                                       HorizontalExpand="True"
                                       VerticalExpand="True"
                                       ExpandBackwards="True"
                                       HSeparationOverride="16"
                                       VSeparationOverride="16">
                            <Label Text="{Loc 'reagent-dispenser-window-no-container-loaded-text'}" />
                        </GridContainer>
                        </ScrollContainer>
                    </PanelContainer>

                </BoxContainer>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
