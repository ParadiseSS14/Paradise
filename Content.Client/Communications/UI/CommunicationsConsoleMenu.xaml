<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'comms-console-menu-title'}"
                      MinSize="450 300">

    <!-- Main Container -->
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  Margin="6 6 6 5">

        <!-- ButtonsPart -->
        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True"
                      VerticalExpand="True"
                      Margin="8 2">
            <PanelContainer StyleClasses="SurfacePrimary">
                <!-- AnnouncePart -->
                <BoxContainer Orientation="Vertical"
                              Margin="8" SeparationOverride="5">

                    <Label Text="{Loc 'comms-console-menu-announcement-section-header'}" StyleClasses="SectionHeader"
                           Margin="0 4 0 0" />

                    <PanelContainer StyleClasses="SeperatorAccented" SetHeight="2" HorizontalExpand="True"
                                    Margin="0 0 0 2" />

                    <Button Name="AnnounceButton"
                            Access="Public"
                            Text="{Loc 'comms-console-menu-announcement-button'}"
                            ToolTip="{Loc 'comms-console-menu-announcement-button-tooltip'}"
                            StyleClasses="OpenLeft"
                            Margin="0 0 0 0"
                            Disabled="True" />

                    <Button Name="BroadcastButton"
                            Access="Public"
                            Text="{Loc 'comms-console-menu-broadcast-button'}"
                            ToolTip="{Loc 'comms-console-menu-broadcast-button-tooltip'}"
                            StyleClasses="OpenBoth" />

                    <controls:TguiOptionButton Name="AlertLevelButton"
                                               Access="Public"
                                               ToolTip="{Loc 'comms-console-menu-alert-level-button-tooltip'}"
                                               StyleClasses="OpenRight" />

                </BoxContainer>
            </PanelContainer>

            <PanelContainer StyleClasses="ListView" VerticalExpand="True" HorizontalExpand="True" Margin="0 8">
                <TextEdit Name="MessageInput"
                          VerticalExpand="True"
                          HorizontalExpand="True"
                          MinHeight="125" Margin="8" />
            </PanelContainer>
            <!-- EmergencyPart -->


            <PanelContainer StyleClasses="SurfacePrimary">
                <BoxContainer Orientation="Vertical"
                              HorizontalExpand="True"
                              VerticalExpand="True"
                              Margin="8">

                    <Label Text="{Loc 'comms-console-menu-shuttle-section-header'}" StyleClasses="SectionHeader"
                           Margin="0 4 8 0" />


                    <PanelContainer StyleClasses="SeperatorAccented" SetHeight="2" HorizontalExpand="True" Margin="0 4" />


                    <RichTextLabel Name="CountdownLabel" Margin="0 8" />

                    <Button Name="EmergencyShuttleButton"
                            Access="Public"
                            Text="Placeholder Text"
                            ToolTip="{Loc 'comms-console-menu-emergency-shuttle-button-tooltip'}" />
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
