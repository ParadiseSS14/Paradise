<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="clr-namespace:Content.Client.Materials.UI"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'lathe-menu-title'}"
    MinSize="650 450"
    SetSize="850 525">
    <BoxContainer
        Orientation="Horizontal"
        VerticalExpand="True"
        HorizontalExpand="True"
        SeparationOverride="5"
        Margin="8">
        <!-- Left Col-->
        <PanelContainer VerticalExpand="True" HorizontalExpand="True" StyleClasses="SurfacePrimary"
                        SizeFlagsStretchRatio="0.5">
            <BoxContainer
                VerticalExpand="True"
                HorizontalExpand="True" Margin="8">
                <BoxContainer
                    Orientation="Vertical"
                    VerticalExpand="True"
                    HorizontalExpand="True"
                    SeparationOverride="5">
                    <Label Text="{Loc 'lathe-menu-categories'}" />

                    <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" />

                    <BoxContainer Orientation="Vertical"
                                  MinHeight="225"
                                  VerticalExpand="True"
                                  HorizontalExpand="True"
                                  SizeFlagsStretchRatio="4">
                        <ScrollContainer VerticalExpand="True" HScrollEnabled="False" Margin="2 10">
                            <BoxContainer
                                Name="CategoryList"
                                Orientation="Vertical"
                                HorizontalExpand="True"
                                VerticalExpand="True"
                                RectClipContent="True">
                            </BoxContainer>
                        </ScrollContainer>
                    </BoxContainer>

                    <Button
                        Name="ServerListButton"
                        Text="{Loc 'lathe-menu-server-list'}"
                        TextAlign="Center"
                        Mode="Press">
                    </Button>
                </BoxContainer>

            </BoxContainer>
        </PanelContainer>
        <!-- seperator -->

        <PanelContainer StyleClasses="SurfacePrimary" VerticalExpand="True"
                        HorizontalExpand="True" SizeFlagsStretchRatio="1.25">

            <BoxContainer Orientation="Vertical" SeparationOverride="5" Margin="8">

                <Label Text="{Loc 'lathe-menu-categories'}" />

                <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" />

                <LineEdit
                    Name="SearchBar"
                    PlaceHolder="{Loc 'lathe-menu-search-designs'}"
                    HorizontalExpand="True">
                </LineEdit>

                <PanelContainer VerticalExpand="True" StyleClasses="ListView">
                    <ScrollContainer VerticalExpand="True" HScrollEnabled="False" Margin="2 10">
                        <BoxContainer
                            Name="RecipeList"
                            Orientation="Vertical"
                            HorizontalExpand="True"
                            VerticalExpand="True"
                            RectClipContent="True">
                        </BoxContainer>
                    </ScrollContainer>
                </PanelContainer>

                <BoxContainer Orientation="Horizontal"
                              HorizontalExpand="True">
                    <Label Margin="8 0 8 0" Text="{Loc 'lathe-menu-amount'}" />
                    <LineEdit
                        Name="AmountLineEdit"
                        PlaceHolder="0"
                        Text="1"
                        HorizontalExpand="True" />
                    <Label Name="RecipeCount" Margin="8 0 8 0" MinWidth="90" Align="Right" />
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <!-- Right Col-->

        <BoxContainer
            Orientation="Vertical"
            VerticalExpand="True"
            HorizontalExpand="True"
            SeparationOverride="5"
            SizeFlagsStretchRatio="0.75">

            <BoxContainer Orientation="Vertical" MinHeight="225">
                <BoxContainer
                    Orientation="Horizontal"
                    Align="End"
                    HorizontalExpand="True">
                </BoxContainer>
                <PanelContainer VerticalExpand="True" StyleClasses="SurfacePrimary">
                    <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                        <Label Text="{Loc 'lathe-menu-queue-title'}" Margin="5 5 5 2" HorizontalAlignment="Center" />
                        <PanelContainer StyleClasses="SeperatorAccented" SetHeight="2" HorizontalExpand="True"
                                        Margin="8 2" />
                        <BoxContainer
                            Name="FabricatingContainer"
                            Orientation="Horizontal"
                            HorizontalExpand="True"
                            SizeFlagsStretchRatio="2">
                            <PanelContainer
                                VerticalExpand="True"
                                HorizontalExpand="True"
                                SizeFlagsStretchRatio="3">
                                <Label
                                    RectClipContent="False"
                                    HorizontalAlignment="Left"
                                    Margin="5 0 0 0"
                                    Text="{Loc 'lathe-menu-fabricating-message'}">
                                </Label>
                                <BoxContainer Name="FabricatingDisplayContainer"
                                              HorizontalAlignment="Left"
                                              Margin="100 0 0 0" />
                                <Label
                                    Name="NameLabel"
                                    RectClipContent="True"
                                    HorizontalAlignment="Left"
                                    Margin="130 0 0 0">
                                </Label>
                                <Button
                                    Name="DeleteFabricating"
                                    Margin="0"
                                    Text="✖"
                                    SetSize="38 32"
                                    HorizontalAlignment="Right"
                                    ToolTip="{Loc 'lathe-menu-delete-fabricating-tooltip'}"
                                    StyleClasses="negative OpenLeft" />
                            </PanelContainer>
                        </BoxContainer>
                        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                            <BoxContainer
                                Name="QueueList"
                                Orientation="Vertical"
                                HorizontalExpand="True"
                                VerticalExpand="True"
                                RectClipContent="True">
                            </BoxContainer>
                        </ScrollContainer>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
            <PanelContainer VerticalExpand="True" StyleClasses="SurfacePrimary">
                <BoxContainer
                    VerticalExpand="True"
                    HorizontalExpand="True"
                    Orientation="Vertical">
                    <Label Text="{Loc 'lathe-menu-materials-title'}" Margin="5 5 5 2" HorizontalAlignment="Center" />
                    <PanelContainer StyleClasses="SeperatorAccented" SetHeight="2" HorizontalExpand="True" Margin="8 4" />

                    <BoxContainer
                        Orientation="Vertical"
                        VerticalExpand="True"
                        HorizontalExpand="True">
                        <ui:MaterialStorageControl Name="MaterialsList" SizeFlagsStretchRatio="8" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>

    </BoxContainer>

</controls:FancyWindow>
