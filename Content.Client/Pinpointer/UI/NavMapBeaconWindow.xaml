<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'nav-beacon-window-title'}"
                      MinSize="150 130" SetSize="300 140" HideIcon="True">
    <PanelContainer StyleClasses="SurfacePrimary" Margin="8 8 8 16">
        <BoxContainer Orientation="Vertical" Margin="8">
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'nav-beacon-text-label'}" Margin="0 0 5 0" HorizontalExpand="True" />
                <LineEdit Name="LabelLineEdit" HorizontalExpand="True" />
                <Button Name="VisibleButton" ToggleMode="True" Text="{Loc 'nav-beacon-toggle-visible'}"
                        Margin="10 0 0 0" MinWidth="100" />
            </BoxContainer>

            <BoxContainer HorizontalExpand="True" VerticalAlignment="Bottom" VerticalExpand="True">
                <Label Text="{Loc 'nav-beacon-tag-color-label'}" Margin="0 0 5 0" HorizontalExpand="True" />

                <Button Name="PickerOpen"  HorizontalExpand="True">
                    <BoxContainer Orientation="Horizontal">
                        <PanelContainer StyleClasses="RoundedColorPreview" SetSize="16 16"/>
                        <Control MinWidth="8"/>
                        <Label Text="{Loc 'decal-placer-window-palette'}"/>
                    </BoxContainer>
                </Button>

                <Control MinWidth="8"/>

                <Button Name="ApplyButton" Text="{Loc 'nav-beacon-button-apply'}" />

            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
