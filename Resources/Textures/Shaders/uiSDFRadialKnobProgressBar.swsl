uniform highp vec2 size;
uniform highp float progressNormalized;
const highp float PI = 3.14159265358979323846;
uniform sampler2D ringTex;
uniform highp vec4 fillColor;
uniform highp vec4 backgroundColor;
uniform highp vec4 knobColor;
uniform highp vec4 knobHighlightColor;

uniform highp float minRange = 0.1;
uniform highp float maxRange = 0.9;

const highp float aa = 0.0075;
const highp float aa2 = 0.0075;
const highp float radius = 0.25;

const highp float handLength = 0.16;
const highp float handThickness = 0.025;

void fragment()
{
    highp vec2 polarUV = UV;
    polarUV = polarUV - 0.5;
    highp float angle = atan(polarUV.x, polarUV.y) / PI;
    angle = (angle + 1) / 2;

    angle = (angle - minRange) / (maxRange - minRange);

    highp float antiAliasedProgressFill = smoothstep(progressNormalized + aa, progressNormalized - aa, angle);

    highp float SDFCircle = length(UV - 0.5);
    highp float outerKnob = smoothstep(radius + aa2, radius - aa2, SDFCircle);

    highp vec4 ringTexure = texture(ringTex, UV);
    highp vec4 radialColor = mix(backgroundColor, fillColor, antiAliasedProgressFill);
    highp float knoblighting = clamp((1-clamp(pow(length(UV - vec2(0.5, 0.6)), 1) / 0.6 + 0.45,0,1) * 1),0,1);
    highp vec4 knobCol = mix(knobColor, knobHighlightColor * 2, knoblighting);

    highp float handRot = (progressNormalized * (maxRange - minRange) + minRange) * 2.0 - 1.0;
    handRot *= PI;
    highp vec2 handDir = vec2(sin(handRot), cos(handRot));

    highp float handProj = clamp(dot(polarUV, handDir), 0.0, handLength);
    highp float handDist = length(polarUV - handDir * handProj);
    highp float handMask = smoothstep(handThickness + aa2, handThickness - aa2, handDist);

    knobCol.rgb = mix(knobCol.rgb * 0.5, knobHighlightColor.rgb * 2, handMask).rgb;

    highp vec3 colOut = mix(radialColor.rgb, knobCol.rgb, smoothstep(radius + 0.015 + aa2, radius + 0.015 - aa2, SDFCircle)).rgb;

    COLOR = vec4(colOut, max(outerKnob, ringTexure.a));
}
